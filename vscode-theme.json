  "tokenColors": [
    {
      "settings": { "foreground": "#f5e6de", "background": "#0d2221" }
    },
    {
      "name": "Plain identifiers, functions, operators and punctuation",
      "scope": ["variable", "entity.name.function", "support.function", "keyword.operator", "punctuation", "constant.other", "entity.other.attribute-name"],
      "settings": { "foreground": "#f5e6de", "fontStyle": "" }
    },
    {
      "name": "Muted comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#759895", "fontStyle": "italic" }
    },
    {
      "name": "Cream keywords",
      "scope": ["keyword", "storage", "entity.name.tag"],
      "settings": { "foreground": "#ebcbb9", "fontStyle": "italic" }
    },
    {
      "name": "Cream types and builtins",
      "scope": ["entity.name.type", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class", "support.function.builtin"],
      "settings": { "foreground": "#ebcbb9", "fontStyle": "" }
    },
    {
      "name": "Lavender strings and literals",
      "scope": ["string", "constant.numeric", "constant.language", "constant.character", "variable.other.enummember"],
      "settings": { "foreground": "#b5b1d8", "fontStyle": "" }
    },
    {
      "name": "Plain object keys",
      "scope": ["support.type.property-name", "meta.object-literal.key", "string.quoted.double.json punctuation.definition.string"],
      "settings": { "foreground": "#f5e6de", "fontStyle": "" }
    },
    {
      "name": "Plain operators",
      "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator"],
      "settings": { "foreground": "#f5e6de", "fontStyle": "" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#ebcbb9", "fontStyle": "bold" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.raw"],
      "settings": { "foreground": "#b5b1d8" }
    },
    {
      "name": "Invalid syntax",
      "scope": ["invalid.illegal"],
      "settings": { "foreground": "#de7686" }
    },
    {
      "name": "Deprecated syntax",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#759895", "fontStyle": "strikethrough" }
    }
  ],
  "semanticTokenColors": {
    "*": "#f5e6de",
    "keyword": { "foreground": "#ebcbb9", "italic": true },
    "type": "#ebcbb9",
    "class": "#ebcbb9",
    "interface": "#ebcbb9",
    "struct": "#ebcbb9",
    "enum": "#ebcbb9",
    "typeParameter": "#ebcbb9",
    "namespace": "#ebcbb9",
    "function.defaultLibrary": "#ebcbb9",
    "method.defaultLibrary": "#ebcbb9",
    "string": "#b5b1d8",
    "number": "#b5b1d8",
    "boolean": "#b5b1d8",
    "regexp": "#b5b1d8",
    "enumMember": "#b5b1d8",
    "comment": { "foreground": "#759895", "italic": true }
  }
}
