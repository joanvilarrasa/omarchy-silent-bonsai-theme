[Plymouth Theme]
Name=Silent Bonsai
Description=Colored bonsai boot and disk-unlock splash.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/silent-bonsai
ScriptFile=/usr/share/plymouth/themes/silent-bonsai/silent-bonsai.script
ConsoleLogBackgroundColor=0x0d2221
MonospaceFont=Cantarell 11
Font=Cantarell 11
