[Unit]
Description=Prevent system sleep while allowing the screensaver

[Service]
ExecStart=/usr/bin/systemd-inhibit --what=sleep --who="Silent Bonsai" --why="Keep the computer awake while allowing the screensaver" --mode=block /usr/bin/sleep infinity
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
